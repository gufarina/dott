{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dott",
  "version": "0.2.17",
  "identifier": "com.studiofarina.dott",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dott",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 660,
        "decorations": false,
        "transparent": false,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "widget",
        "title": "Dott Widget",
        "width": 104,
        "height": 104,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/attachments/*", "$APPDATA/attachments/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Studio Farina",
    "copyright": "© 2026 Studio Farina",
    "category": "Productivity",
    "shortDescription": "Sua mente, organizada.",
    "longDescription": "Dott — workspace pessoal de conhecimento baseado no método PARA. Captura rápida, notas conectadas e organização sem atrito.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "template": "installer/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  }
}
